{
  "metadata": [
    {
      "src": [
        {
          "files": ["../PersonalFinanceTracker/PersonalFinanceTracker.csproj"],
          "cwd": "."
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": ["**/*.md"]
      },
      {
        "files": ["api/**.yml"],
        "src": "api"
      }
    ],
    "dest": "_site",
    "globalMetadata": {
      "_appTitle": "PersonalFinanceTracker API"
    }
  }
}
