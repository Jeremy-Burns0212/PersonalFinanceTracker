@using PersonalFinanceTracker.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> userManager
@{
    var currentUser = await userManager.GetUserAsync(User);
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Personal Finance Tracker</title>
    <script type="import"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PersonalFinanceTracker.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark app-nav border-bottom box-shadow">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" asp-area="" asp-controller="Home" asp-action="Index">Personal Finance Tracker</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex w-100">
                    <ul class="navbar-nav nav-main me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Transcripts/Index">Transcripts</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Transactions/Index">Transactions</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3 ms-auto nav-auth">

                        @if (User?.Identity?.IsAuthenticated ?? false)
                        {
                            <span class="navbar-text nav-user-pill">Welcome, @(currentUser?.FullName ?? User.Identity?.Name)</span>

                            <ul class="navbar-nav align-items-center gap-2">
                                <li class="nav-item">
                                    <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline" asp-antiforgery="true">
                                        <button type="submit" class="btn btn-sm btn-outline-light nav-action">Logout</button>
                                    </form>
                                </li>
                                <li class="nav-item">
                                    <form asp-area="Identity" asp-page="/Account/DeleteAccount" method="post" class="d-inline" asp-antiforgery="true" onsubmit="return confirm('Are you sure you want to delete your account? This action cannot be undone.');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger nav-action">Delete Account</button>
                                    </form>
                                </li>
                            </ul>
                        }
                        else
                        {
                            <span class="navbar-text nav-user-pill nav-user-pill-empty">Guest</span>

                            <ul class="navbar-nav align-items-center gap-2">
                                <li class="nav-item">
                                    <a class="btn btn-sm btn-outline-light nav-action" asp-area="Identity" asp-page="/Account/Register">Register</a>
                                </li>
                                <li class="nav-item">
                                    <a class="btn btn-sm btn-light nav-action" asp-area="Identity" asp-page="/Account/Login">Login</a>
                                </li>
                            </ul>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="page-shell">
        <main role="main" class="page-main">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="container">
            &copy; 2026 - Personal Finance Tracker - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
