@page "{id:int}"
@model PersonalFinanceTracker.Pages.Transcripts.EditModel

@{
    ViewData["Title"] = "Edit Transcript";
}

<h1>Edit Transcript</h1>

<div class="row">
    <div class="col-lg-5">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Transcript.Id" />
            <input type="hidden" asp-for="Transcript.DateCreated" />
            <input type="hidden" asp-for="Transcript.LastAccessed" />
            <input type="hidden" asp-for="Transcript.UserId" />

            <div class="mb-3">
                <label asp-for="Transcript.Name" class="form-label"></label>
                <input asp-for="Transcript.Name" class="form-control" />
                <span asp-validation-for="Transcript.Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Transcript.Description" class="form-label"></label>
                <textarea asp-for="Transcript.Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Transcript.Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Saved</label>
                <input class="form-control" value="@Model.Transcript.DateCreated.ToLocalTime().ToString("g")" readonly />
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="./Details" asp-route-id="@Model.Transcript.Id" class="btn btn-secondary">Back to details</a>
        </form>
    </div>
</div>

<hr class="my-4" />

<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h2 class="h4 mb-1">Archived Transactions</h2>
        <p class="text-muted mb-0">Edit or delete individual items inside this transcript.</p>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Date</th>
                <th>Description</th>
                <th>Type</th>
                <th>Category</th>
                <th>Amount</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var transaction in Model.Transcript.Transactions.OrderByDescending(item => item.Date))
        {
            <tr>
                <td>@transaction.Date.ToString("d")</td>
                <td>@transaction.Description</td>
                <td>@transaction.Type</td>
                <td>@(transaction.CategoryName ?? "-")</td>
                <td>@transaction.Amount.ToString("C")</td>
                <td class="text-nowrap">
                    <a asp-page="./EditTransaction" asp-route-transcriptId="@Model.Transcript.Id" asp-route-id="@transaction.Id" class="btn btn-sm btn-primary">Edit</a>
                    <a asp-page="./DeleteTransaction" asp-route-transcriptId="@Model.Transcript.Id" asp-route-id="@transaction.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}