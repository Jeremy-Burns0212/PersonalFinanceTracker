@page "{id:int}"
@model PersonalFinanceTracker.Pages.Transcripts.DetailsModel

@{
    ViewData["Title"] = "Transcript Details";
}

@* staged: add transcripts CRUD files *@

<div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between gap-3 mb-4">
    <div>
        <h1 class="mb-1">@Model.Transcript.Name</h1>
        <p class="text-muted mb-0">Archived on @Model.Transcript.DateCreated.ToLocalTime().ToString("g")</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-page="./Edit" asp-route-id="@Model.Transcript.Id" class="btn btn-primary">Edit</a>
        <a asp-page="./Delete" asp-route-id="@Model.Transcript.Id" class="btn btn-danger">Delete</a>
        <a asp-page="./Index" class="btn btn-secondary">Back to list</a>
    </div>
</div>

<dl class="row">
    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@(Model.Transcript.Description ?? "-")</dd>

    <dt class="col-sm-3">Saved</dt>
    <dd class="col-sm-9">@Model.Transcript.DateCreated.ToLocalTime().ToString("g")</dd>

    <dt class="col-sm-3">Last Accessed</dt>
    <dd class="col-sm-9">@Model.Transcript.LastAccessed.ToLocalTime().ToString("g")</dd>

    <dt class="col-sm-3">Transactions</dt>
    <dd class="col-sm-9">@Model.Transcript.Transactions.Count</dd>
</dl>

<div class="table-responsive mt-4">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Date</th>
                <th>Description</th>
                <th>Type</th>
                <th>Category</th>
                <th>Amount</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var transaction in Model.Transcript.Transactions.OrderByDescending(item => item.Date))
        {
            <tr>
                <td>@transaction.Date.ToString("d")</td>
                <td>@transaction.Description</td>
                <td>@transaction.Type</td>
                <td>@(transaction.CategoryName ?? "-")</td>
                <td>@transaction.Amount.ToString("C")</td>
                <td class="text-nowrap">
                    <a asp-page="./EditTransaction" asp-route-transcriptId="@Model.Transcript.Id" asp-route-id="@transaction.Id" class="btn btn-sm btn-primary">Edit</a>
                    <a asp-page="./DeleteTransaction" asp-route-transcriptId="@Model.Transcript.Id" asp-route-id="@transaction.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>