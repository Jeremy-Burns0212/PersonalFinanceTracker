@page
@model PersonalFinanceTracker.Pages.Transactions.IndexModel

@{
    ViewData["Title"] = "Transactions";
}

<h1>Transactions</h1>

<form method="post" asp-page-handler="Archive" class="row row-cols-1 row-cols-md-auto g-2 align-items-end mb-4">
    <div class="col">
        <label asp-for="TranscriptName" class="form-label">Transcript Name</label>
        <input asp-for="TranscriptName" class="form-control" placeholder="Taxes, Bills, February etc." />
        <span asp-validation-for="TranscriptName" class="text-danger"></span>
    </div>
    <div class="col d-flex gap-2 flex-wrap">
        <a asp-page="CreateTransactions" class="btn btn-primary">Add Transaction</a>
        <button type="submit" class="btn btn-success">Save as Transcript</button>
    </div>
</form>

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Date</th>
            <th>Description</th>
            <th>Type</th>
            <th>Category</th>
            <th>Amount</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Transactions)
{
        <tr>
            <td>@item.Date.ToShortDateString()</td>
            <td>@item.Description</td>
            <td>@item.Type</td>
            <td>@(item.Category?.Name ?? "-")</td>
            <td>@item.Amount.ToString("C")</td>
            <td>
                <a asp-page="UpdateTransactions" class="btn btn-sm btn-primary" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="DetailsTransactions" class="btn btn-sm btn-secondary" asp-route-id="@item.Id">Details</a> |
                <a asp-page="DeleteTransactions" class="btn btn-sm btn-danger" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
